# Dockerfile for FastAPI Agent Host
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y \
    gcc \
    default-mysql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appuser agent_host/ ./agent_host/
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser mcp/ ./mcp/
COPY --chown=appuser:appuser mcp_server/ ./mcp_server/
COPY --chown=appuser:appuser .env* ./

USER appuser

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8100/api/health || exit 1

CMD ["python", "-m", "uvicorn", "agent_host.main:app", "--host", "0.0.0.0", "--port", "8100"]
