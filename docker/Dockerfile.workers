# Dockerfile for the shared Agent Runtime and MCP Gateway image.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y \
    gcc \
    default-mysql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-bundle the embedding and rerank models into the image so the container
# never downloads from HuggingFace at runtime. Models land in /opt/models.
ENV HF_HOME=/opt/models \
    SENTENCE_TRANSFORMERS_HOME=/opt/models \
    TRANSFORMERS_CACHE=/opt/models
COPY scripts/prefetch_models.py /tmp/prefetch_models.py
RUN python /tmp/prefetch_models.py && rm /tmp/prefetch_models.py && \
    chown -R appuser:appuser /opt/models

# Force fully-offline model loading at runtime: a missing model fails loudly
# instead of silently reaching out to the network.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser agent_runtime/ ./agent_runtime/
COPY --chown=appuser:appuser domain/ ./domain/
COPY --chown=appuser:appuser core/ ./core/
COPY --chown=appuser:appuser tools/ ./tools/
COPY --chown=appuser:appuser agents/ ./agents/
COPY --chown=appuser:appuser graph/ ./graph/
COPY --chown=appuser:appuser evals/ ./evals/
COPY --chown=appuser:appuser memory/ ./memory/
COPY --chown=appuser:appuser knowledge/ ./knowledge/
COPY --chown=appuser:appuser models/ ./models/
COPY --chown=appuser:appuser workers/ ./workers/
COPY --chown=appuser:appuser mcp_gateway/ ./mcp_gateway/
COPY --chown=appuser:appuser .env* ./

USER appuser

EXPOSE 8200

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import socket; s=socket.create_connection(('localhost',8200),3); s.close()" || exit 1

CMD ["python", "-m", "mcp_gateway", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8200"]
